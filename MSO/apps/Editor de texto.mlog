control enabled processor1 1 0 0 0
set CaractereAtual 0
set CaracteresLim 256
op sub CaracteresTotais CaracteresLim 1
ubind @main()
read Recebeu? cell1 1
read CaractereAtual cell2 63
jump 5 notEqual Recebeu? 1
read Caractere cell1 0
format "Despacho de comandos, se não for é caractere"
jump 21 strictEqual Caractere 37
jump 28 strictEqual Caractere 38
jump 33 strictEqual Caractere 64
jump 37 strictEqual Caractere 65
jump 48 strictEqual Caractere 66
jump 51 strictEqual Caractere 76
jump -1 strictEqual Caractere 60
jump -1 strictEqual Caractere 71
jump 59 always Caractere 1
end
format "Apaga tudo e reinicia"
set k 0
write 36 bank1 k
op add k k 1
jump 22 lessThan k CaracteresLim
write 0 cell1 1
write 0 cell2 63
end
jump 30 strictEqual CaractereAtual 0
op sub CaractereAtual CaractereAtual 1
write 36 bank1 CaractereAtual
jump 63 always CaractereAtual CaracteresLim
end
jump 35 strictEqual CaractereAtual 0
op sub CaractereAtual CaractereAtual 1
jump 63 always CaractereAtual CaracteresLim
end
format "Vai para o último caractere escrito, não conta o espaço"
set k CaracteresTotais
read CaractereA bank1 k
jump 43 strictEqual CaractereA 36
set CaractereAtual k
jump 46 always CaractereA 36
op sub k k 1
jump 39 greaterThanEq k 0
set CaractereAtual -1
jump 62 always CaractereAtual CaracteresLim
end
jump 63 strictEqual CaractereAtual CaracteresTotais
jump 62 always CaractereAtual 63
end
format "Enter"
op idiv Caractere1 CaractereAtual 16
op add Caractere2 Caractere1 1
op mul CaractereTeste Caractere2 16
jump 63 greaterThan CaractereTeste CaracteresLim
op mul CaractereAtual Caractere2 16
jump 63 always CaractereAtual 63
end
op sub Caractere-2 Caractere 2
select Caractere greaterThan Caractere 37 Caractere-2 Caractere
write Caractere bank1 CaractereAtual
op add CaractereAtual CaractereAtual 1
write 0 cell1 1
write CaractereAtual cell2 63
jump 5 lessThan CaractereAtual CaracteresLim
ubind @main()
format "Apaga tudo e reinicia"
set k 0
write 36 bank1 k
op add k k 1
jump 69 lessThan k CaracteresLim
write 0 bank1 510
write 0 cell2 63
