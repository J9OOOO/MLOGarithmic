op mul b1 2b @radToDeg
op cos Cos(b) b1 d
op sin Sin(b) b1 d
op mul e^2zR e^a Cos(b)
op mul e^2zI e^a Sin(b)
sensor result block1 @copper
op add e^2z+1R e^2zR 1
op add e^2z+1I e^2zI 0
sensor result block1 @copper
op sub e^2z-1R e^2zR 1
op sub e^2z-1I e^2zI 0
sensor result block1 @copper
sensor result block1 @copper
format "Divisão (a+bi) / (c+di):"
format "e^2z-1R + e^2z-1Ii"
format "e^2z+1R + e^2z+1Ii"
op mul AbsW0 e^2z+1R e^2z+1R
op mul AbsW1 e^2z+1I e^2z+1I
op add AbsW AbsW0 AbsW1
op mul DemR0 e^2z-1R e^2z+1R
op mul DemR1 e^2z-1I e^2z+1I
op add DemR DemR0 DemR1
op mul DemI0 e^2z-1I e^2z+1R
op mul DemI1 e^2z-1R e^2z+1I
op sub DemI DemI0 DemI1
op div outG DemR AbsW
op div outH DemI AbsW
sensor result block1 @copper
sensor result block1 @copper
format "- z = - a - bi"
format "Meu Deus, o limite é de 1000 linhas..."
sensor result block1 @copper
jump 967 always T null
end
end
sensor result block1 @copper
format "Arco seno hiperbólico asinh(a+bi):"
format "O corpo é ln(z+sqrt(z^2+1))"
op mul a^2 a a
op mul b^2 b b
op sub Rz^2 a^2 b^2
op mul ab a b
op mul 2ab 2 ab
op add z^2+1R 1 Rz^2
op mul z^2+1I 1 2ab
sensor result block1 @copper
sensor result block1 @copper
format "Raiz quadrada sqrt(a+bi):"
sensor result block1 @copper
op angle ThetaZ z^2+1R z^2+1I
format "Pelo visto tem que normalizar isso para dar certo..."
jump 786 lessThanEq ThetaZ 180
op sub ThetaZ ThetaZ 360
op mul ThetaZ ThetaZ @degToRad
format "Pqp, eu vou reescrever essa radiciação por completo"
format "abs(z)^1/2*(cos(theta)+isin(theta)"
op mul RY0 z^2+1R z^2+1R
op mul RY1 z^2+1I z^2+1I
op add RY2 RY0 RY1
op sqrt RY RY2 RY1
op sqrt RY RY RY1
format "abs(z)^1/2"
op div ThetaZ/2 ThetaZ 2
op mul ThetaZ/2 ThetaZ/2 @radToDeg
op cos Cos(ThetaZ/2) ThetaZ/2 null
op sin Sin(ThetaZ/2) ThetaZ/2 null
op mul sqrt(z^2+1)R RY Cos(ThetaZ/2)
op mul sqrt(z^2+1)I RY Sin(ThetaZ/2)
op add zi+sqrt(z^2+1)R a sqrt(z^2+1)R
op add zi+sqrt(z^2+1)I b sqrt(z^2+1)I
sensor result block1 @copper
sensor result block1 @copper
format "Ln de (a+bi):"
format "ln(sqrt(a^2+b^2)) = (1/2) * ln(a^2+b^2)"
op mul AbsA zi+sqrt(z^2+1)R zi+sqrt(z^2+1)R
op mul AbsB zi+sqrt(z^2+1)I zi+sqrt(z^2+1)I
op add AbsZ AbsA AbsB
op log ln(AbsZ) AbsZ AbsB
ubind null
jump 945 strictEqual ln(AbsZ) null
ubind null
op angle Theta zi+sqrt(z^2+1)R zi+sqrt(z^2+1)I
jump 817 lessThanEq Theta 180
op sub Theta Theta 360
op mul Theta Theta @degToRad
op mul ln(zi+sqrt(z^2+1)R) 0.5 ln(AbsZ)
set ln(zi+sqrt(z^2+1)I) Theta
sensor result block1 @copper
set outG ln(zi+sqrt(z^2+1)R)
op mul outH ln(zi+sqrt(z^2+1)I) 1
sensor result block1 @copper
sensor result block1 @copper
jump 967 always T null
end
end
sensor result block1 @copper
format "Arco cosseno hiperbólico acosh(a+bi):"
format "O corpo é ln(z+sqrt(z^2-1))"
op mul a^2 a a
op mul b^2 b b
op sub Rz^2 a^2 b^2
op mul ab a b
op mul 2ab 2 ab
op sub z^2-1R Rz^2 1
op mul z^2-1I 1 2ab
sensor result block1 @copper
sensor result block1 @copper
format "Raiz quadrada sqrt(a+bi):"
sensor result block1 @copper
op angle ThetaZ z^2-1R z^2-1I
format "Pelo visto tem que normalizar isso para dar certo..."
jump 846 lessThanEq ThetaZ 180
op sub ThetaZ ThetaZ 360
op mul ThetaZ ThetaZ @degToRad
format "Pqp, eu vou reescrever essa radiciação por completo"
format "abs(z)^1/2*(cos(theta)+isin(theta)"
op mul RY0 z^2-1R z^2-1R
op mul RY1 z^2-1I z^2-1I
op add RY2 RY0 RY1
op sqrt RY RY2 RY1
op sqrt RY RY RY1
format "abs(z)^1/2"
op div ThetaZ/2 ThetaZ 2
op mul ThetaZ/2 ThetaZ/2 @radToDeg
op cos Cos(ThetaZ/2) ThetaZ/2 null
op sin Sin(ThetaZ/2) ThetaZ/2 null
op mul sqrt(z^2-1)R RY Cos(ThetaZ/2)
op mul sqrt(z^2-1)I RY Sin(ThetaZ/2)
op add z+sqrt(z^2-1)R a sqrt(z^2-1)R
op add z+sqrt(z^2-1)I b sqrt(z^2-1)I
