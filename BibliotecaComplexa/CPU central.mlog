format "- i * (a +bi) = b - ai"
format "MANO"
format "Isso é a biblioteca MLOG de números complexas feita por J9AOOO"
format "Aproveite a resenha: "
format "0: sinal"
format "1: 1º parte real do input (a)"
format "2: 1º parte imaginária do input (b)"
format "3: 2º parte realdo input  (c)"
format "4: 2º parte imaginária do input (d)"
format "5: operador"
format "8: 1º parte real do output (g)"
format "9: 1º parte imaginária do output (h)"
format "O conceito é:"
format "operação(a+bi, c+di) -> g+hi"
format "Z = a + bi"
format "W = c + di"
format "Y = g + hi"
sensor result block1 @copper
sensor result block1 @copper
read Sinal cell1 0
jump 19 notEqual Sinal 1
write -1 cell1 0
read a cell1 1
read b cell1 2
read c cell1 3
read d cell1 4
read Operador cell1 5
jump 56 strictEqual Operador 1
jump 64 strictEqual Operador 2
jump 72 strictEqual Operador 3
jump 84 strictEqual Operador 4
jump 105 strictEqual Operador 5
jump 116 strictEqual Operador 6
jump 125 strictEqual Operador 7
jump 136 strictEqual Operador 8
jump 147 strictEqual Operador 9
jump 167 strictEqual Operador 10
jump 217 strictEqual Operador 11
jump 230 strictEqual Operador 12
jump 283 strictEqual Operador 13
jump 322 strictEqual Operador 14
jump 358 strictEqual Operador 15
jump 393 strictEqual Operador 16
jump 428 strictEqual Operador 17
jump 456 strictEqual Operador 18
jump 524 strictEqual Operador 19
jump 597 strictEqual Operador 20
jump 659 strictEqual Operador 21
jump 692 strictEqual Operador 22
jump 725 strictEqual Operador 23
jump 768 strictEqual Operador 24
jump 828 strictEqual Operador 25
jump 887 strictEqual Operador 26
jump 937 strictEqual Operador 27
jump 945 always Operador 20
end
sensor result block1 @copper
format "Soma (a+bi) + (c+di):"
op add outG a c
op add outH b d
sensor result block1 @copper
jump 967 always T null
end
end
sensor result block1 @copper
format "Subtração (a+bi) - (c+di):"
