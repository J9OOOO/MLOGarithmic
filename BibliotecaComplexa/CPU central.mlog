sensor result block1 @copper
op sub e^z-e^(-z)R e^zR e^(-z)R
op sub e^z-e^(-z)I e^zI e^(-z)I
op div outG e^z-e^(-z)R 2
op div outH e^z-e^(-z)I 2
format "Meu Deus, o limite é de 1000 linhas..."
sensor result block1 @copper
jump 967 always T null
end
end
sensor result block1 @copper
format "Cosseno hiperbólico cosh(a+bi)"
format "z = a + bi"
sensor result block1 @copper
format "exp de (a+bi):"
op pow e^a @e a
op mul b1 b @radToDeg
op cos Cos(b) b1 d
op sin Sin(b) b1 d
op mul e^zR e^a Cos(b)
op mul e^zI e^a Sin(b)
sensor result block1 @copper
format "- z = - a - bi"
op mul -a -1 a
op mul -b -1 b
sensor result block1 @copper
format "exp de (a+bi):"
op pow e^(-a) @e -a
op mul -b1 -b @radToDeg
op cos Cos(-b) -b1 d
op sin Sin(-b) -b1 d
op mul e^(-z)R e^(-a) Cos(-b)
op mul e^(-z)I e^(-a) Sin(-b)
sensor result block1 @copper
op add e^z+e^(-z)R e^zR e^(-z)R
op add e^z+e^(-z)I e^zI e^(-z)I
op div outG e^z+e^(-z)R 2
op div outH e^z+e^(-z)I 2
format "Meu Deus, o limite é de 1000 linhas..."
sensor result block1 @copper
jump 967 always T null
end
end
