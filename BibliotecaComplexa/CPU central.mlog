sensor result block1 @copper
format "Tangente tan(a+bi):"
op mul 2a 2 a
op mul 2b 2 b
op mul -2a -1 2a
op mul -2b -1 2b
format "sinh(2b)"
op pow e^2b @e 2b
op pow e^(-2b) @e -2b
op sub e^2b-e^(-2b) e^2b e^(-2b)
op div sinh(2b) e^2b-e^(-2b) 2
format "cosh(2b)"
op pow e^2b @e 2b
op pow e^(-2b) @e -2b
op add e^2b+e^(-2b) e^2b e^(-2b)
op div cosh(2b) e^2b+e^(-2b) 2
format "Aqui é mais fácil, só sin(2a)/(cos(2a)+cosh(2b)):"
op mul 2a 2a @radToDeg
op sin sin(2a) 2a @radToDeg
op cos cos(2a) 2a @radToDeg
op add dem cos(2a) cosh(2b)
op div outG sin(2a) dem
format "Aqui é mais fácil também, só sinh(2a)/(cos(2a)+cosh(2b)):"
op div outH sinh(2b) dem
sensor result block1 @copper
jump 967 always T null
end
end
