op cos Cos(ThetaY) ThetaY null
op sin Sin(ThetaY) ThetaY null
op mul sqrt(z^2-1)R RY Cos(ThetaY)
op mul sqrt(z^2-1)I RY Sin(ThetaY)
sensor result block1 @copper
op mul IZR -1 b
set IZI a
sensor result block1 @copper
