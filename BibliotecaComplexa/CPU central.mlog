end
end
sensor result block1 @copper
format "exp de (a+bi):"
format "Ele sobrescrevia b nas primeiras versões, agora não mais"
op pow e^a @e a
op mul bDeg b @radToDeg
op cos Cos(bDeg) bDeg d
op sin Sin(bDeg) bDeg d
op mul outG e^a Cos(bDeg)
op mul outH e^a Sin(bDeg)
