sensor result block1 @copper
format "Arco tangente atan(a+bi):"
format "iz = i * (a + bi) = - b + ai"
op mul IZR -1 b
set IZI a
format "1+iz"
op add 1+izR 1 IZR
set 1+izI IZI
format "1-iz"
op sub 1-izR 1 IZR
op mul 1-izI -1 IZI
format "(a+bi) = 1 + iz"
format "(c+di) = 1 - iz"
sensor result block1 @copper
format "Divisão (a+bi) / (c+di):"
op mul AbsW0 1-izR 1-izR
op mul AbsW1 1-izI 1-izI
op add AbsW AbsW0 AbsW1
op mul DemR0 1+izR 1-izR
op mul DemR1 1+izI 1-izI
op add DemR DemR0 DemR1
op mul DemI0 1+izI 1-izR
op mul DemI1 1+izR 1-izI
op sub DemI DemI0 DemI1
op div (1+iz)/(1-iz)R DemR AbsW
op div (1+iz)/(1-iz)I DemI AbsW
sensor result block1 @copper
format "Agora o ln..."
format "a = (1+iz)/(1-iz)R"
format "b = (1+iz)/(1-iz)I"
sensor result block1 @copper
format "Ln de (a+bi):"
format "ln(sqrt(a^2+b^2)) = (1/2) * ln(a^2+b^2)"
op mul AbsA (1+iz)/(1-iz)R (1+iz)/(1-iz)R
op mul AbsB (1+iz)/(1-iz)I (1+iz)/(1-iz)I
op add AbsZ AbsA AbsB
op log ln(AbsZ) AbsZ AbsB
op angle Theta (1+iz)/(1-iz)R (1+iz)/(1-iz)I
jump 600 lessThanEq Theta 180
op sub Theta Theta 360
op mul Theta Theta @degToRad
op mul ln((1+iz)/(1-iz))R 0.5 ln(AbsZ)
set ln((1+iz)/(1-iz))I Theta
sensor result block1 @copper
format "Agora multiplicar por - i / 2"
format "Eu abstraí o ln((1+iz)/(1-iz)) para não atrapalhar a leitura, troquei só por '...'"
op mul ln(...)/2R 0.5 ln((1+iz)/(1-iz))R
op mul ln(...)/2I 0.5 ln((1+iz)/(1-iz))I
set outG ln(...)/2I
op mul outH -1 ln(...)/2R
format "Veja isso depois, alterei sem querer"
sensor result block1 @copper
jump 637 always T null
end
end
sensor result block1 @copper
format "Os erros ficam aqui"
format "null === algo deu errado"
write -2 cell1 0
print "Erro de operação, veja o que você inseriu:"
print "                                                                "
print "a b c d operador"
print "                                                                "
print a
print " "
print b
print " "
print c
print " "
print d
print " "
print Operador
printflush message1
read Leu? cell1 0
jump 633 strictEqual Leu? -2
sensor result block1 @copper
end
sensor result block1 @copper
format "Se deu tudo certo fica aqui:"
format "Verificação final, só caso dê errado algo"
jump 615 strictEqual outG null
jump 615 strictEqual outH null
write outG cell1 8
write outH cell1 9
write 2 cell1 0
print "Não se preocupe, deu tudo certo"
printflush message1
print outG
print "+"
print outH
print "i"
printflush message2
read Leu? cell1 0
jump 652 strictEqual Leu? 2
sensor result block1 @copper
end
