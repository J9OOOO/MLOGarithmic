op mul b^2 b b
op sub Rz^2 a^2 b^2
op mul ab a b
op mul 2ab 2 ab
format "1 - z^2"
format "1 - z^2R - (z^2I)i"
format "1 - a^2 - b^2 - (2ab)i"
