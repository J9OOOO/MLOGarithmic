sensor result block1 @copper
format "Seno sin(a+bi):"
sensor result block1 @copper
op mul -a -1 a
op mul -b -1 b
format "exp de (-b+ai):"
format "MALDITO I FDP"
op pow e^(-b) @e -b
op mul a a @radToDeg
op cos Cos(a) a d
op sin Sin(a) a d
op mul e^zR e^(-b) Cos(a)
op mul e^zI e^(-b) Sin(a)
sensor result block1 @copper
sensor result block1 @copper
