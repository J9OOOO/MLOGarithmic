op sub ThetaZ ThetaZ 360
op mul ThetaZ ThetaZ @degToRad
op mul RZ0 a a
op mul RZ1 b b
op add RZ2 RZ0 RZ1
op sqrt RZ RZ2 n
op pow nrt(RZ) RZ n
op mul RY nrt(RZ) 1
