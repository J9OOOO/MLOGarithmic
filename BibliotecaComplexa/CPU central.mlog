op sin Sin(-a) -a d
op mul e^(-z)R e^b Cos(-a)
op mul e^(-z)I e^b Sin(-a)
sensor result block1 @copper
sensor result block1 @copper
op sub R1? e^(-z)R e^zR
op div R? R1? 2
op sub I1? e^zI e^(-z)I
op div I? I1? 2
format "(R?+I?*i)/i"
format "iR?+I?"
set outG I?
set outH R?
jump 637 always T null
end
end
