op div ThetaZ/2 ThetaZ 2
op mul ThetaZ/2 ThetaZ/2 @radToDeg
op cos Cos(ThetaZ/2) ThetaZ/2 null
op sin Sin(ThetaZ/2) ThetaZ/2 null
op mul sqrt(z^2-1)R RY Cos(ThetaZ/2)
op mul sqrt(z^2-1)I RY Sin(ThetaZ/2)
op add z+sqrt(z^2-1)R a sqrt(z^2-1)R
op add z+sqrt(z^2-1)I b sqrt(z^2-1)I
sensor result block1 @copper
sensor result block1 @copper
format "Ln de (a+bi):"
format "ln(sqrt(a^2+b^2)) = (1/2) * ln(a^2+b^2)"
op mul AbsA z+sqrt(z^2-1)R z+sqrt(z^2-1)R
op mul AbsB z+sqrt(z^2-1)I z+sqrt(z^2-1)I
op add AbsZ AbsA AbsB
op log ln(AbsZ) AbsZ AbsB
op angle Theta z+sqrt(z^2-1)R z+sqrt(z^2-1)I
jump 647 lessThanEq Theta 180
op sub Theta Theta 360
op mul Theta Theta @degToRad
op mul ln(z+sqrt(z^2-1)R) 0.5 ln(AbsZ)
set ln(z+sqrt(z^2-1)I) Theta
sensor result block1 @copper
set outG ln(z+sqrt(z^2-1)R)
set outH ln(z+sqrt(z^2-1)I)
sensor result block1 @copper
sensor result block1 @copper
jump 741 always T null
end
end
sensor result block1 @copper
format "Arco cotangente hiperbólica acoth(a+bi):"
sensor result block1 @copper
format "Divisão (a+bi) / (c+di):"
op mul AbsW0 a a
op mul AbsW1 b b
op add AbsW AbsW0 AbsW1
set DemR a
op mul DemI -1 b
op div a DemR AbsW
op div b DemI AbsW
sensor result block1 @copper
format "1+z"
op add 1+zR 1 a
set 1+zI b
format "1-z"
format "(a+bi) = 1 - z"
format "(c+di) = 1 + z"
sensor result block1 @copper
op sub 1-zR 1 a
op mul 1-zI -1 b
format "Divisão (a+bi) / (c+di):"
op mul AbsW0 1-zR 1-zR
op mul AbsW1 1-zI 1-zI
op add AbsW AbsW0 AbsW1
op mul DemR0 1+zR 1-zR
op mul DemR1 1+zI 1-zI
op add DemR DemR0 DemR1
op mul DemI0 1+zI 1-zR
op mul DemI1 1+zR 1-zI
op sub DemI DemI0 DemI1
op div (1+z)/(1-z)R DemR AbsW
op div (1+z)/(1-z)I DemI AbsW
sensor result block1 @copper
format "Agora o ln..."
format "a = (1+z)/(1-z)R"
format "b = (1+z)/(1-z)I"
sensor result block1 @copper
format "Ln de (a+bi):"
format "ln(sqrt(a^2+b^2)) = (1/2) * ln(a^2+b^2)"
op mul AbsA (1+z)/(1-z)R (1+z)/(1-z)R
op mul AbsB (1+z)/(1-z)I (1+z)/(1-z)I
op add AbsZ AbsA AbsB
op log ln(AbsZ) AbsZ AbsB
op angle Theta (1+z)/(1-z)R (1+z)/(1-z)I
jump 705 lessThanEq Theta 180
op sub Theta Theta 360
op mul Theta Theta @degToRad
op mul ln((1+z)/(1-z))R 0.5 ln(AbsZ)
set ln((1+z)/(1-z))I Theta
sensor result block1 @copper
format "Eu abstraí o ln((1+z)/(1-z)) para não atrapalhar a leitura, troquei só por '...'"
op mul ln(...)/2R 0.5 ln((1+z)/(1-z))R
op mul ln(...)/2I 0.5 ln((1+z)/(1-z))I
set outG ln(...)/2R
set outH ln(...)/2I
format "Veja isso depois, alterei sem querer"
sensor result block1 @copper
jump 741 always T null
end
end
sensor result block1 @copper
format "Os erros ficam aqui"
format "null === algo deu errado"
write -2 cell1 0
print "Erro de operação, veja o que você inseriu:"
print "                                                                "
print "a b c d operador"
print "                                                                "
print a
print " "
print b
print " "
print c
print " "
print d
print " "
print Operador
printflush message1
read Leu? cell1 0
jump 737 strictEqual Leu? -2
sensor result block1 @copper
end
sensor result block1 @copper
format "Se deu tudo certo fica aqui:"
format "Verificação final, só caso dê errado algo"
jump 719 strictEqual outG null
jump 719 strictEqual outH null
write outG cell1 8
write outH cell1 9
write 2 cell1 0
print "Não se preocupe, deu tudo certo"
printflush message1
print outG
print "+"
print outH
print "i"
printflush message2
read Leu? cell1 0
jump 756 strictEqual Leu? 2
sensor result block1 @copper
end
