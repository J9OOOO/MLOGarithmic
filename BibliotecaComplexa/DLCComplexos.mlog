op mul AbsB (1+iz)/(1-iz)I (1+iz)/(1-iz)I
op add AbsZ AbsA AbsB
op log ln(AbsZ) AbsZ AbsB
op angle Theta (1+iz)/(1-iz)R (1+iz)/(1-iz)I
jump 371 lessThanEq Theta 180
op sub Theta Theta 360
op mul Theta Theta @degToRad
op mul ln((1+iz)/(1-iz))R 0.5 ln(AbsZ)
set ln((1+iz)/(1-iz))I Theta
sensor result block1 @copper
format "Agora multiplicar por - i / 2"
format "Eu abstraí o ln((1+iz)/(1-iz)) para não atrapalhar a leitura, troquei só por '...'"
op mul ln(...)/2R 0.5 ln((1+iz)/(1-iz))R
op mul ln(...)/2I 0.5 ln((1+iz)/(1-iz))I
set outG ln(...)/2I
op mul outH -1 ln(...)/2R
format "Veja isso depois, alterei sem querer"
sensor result block1 @copper
jump 741 always T null
end
end
