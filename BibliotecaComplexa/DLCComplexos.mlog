sensor result block1 @copper
format "iz = i * (a + bi) = - b + ai"
op mul IZR -1 b
set IZI a
format "1+iz"
op add 1+izR 1 IZR
set 1+izI IZI
format "1-iz"
op sub 1-izR 1 IZR
op mul 1-izI -1 IZI
format "(a+bi) = 1 + iz"
format "(c+di) = 1 - iz"
sensor result block1 @copper
format "Divisão (a+bi) / (c+di):"
op mul AbsW0 1-izR 1-izR
op mul AbsW1 1-izI 1-izI
op add AbsW AbsW0 AbsW1
op mul DemR0 1+izR 1-izR
op mul DemR1 1+izI 1-izI
op add DemR DemR0 DemR1
op mul DemI0 1+izI 1-izR
op mul DemI1 1+izR 1-izI
op sub DemI DemI0 DemI1
op div (1+iz)/(1-iz)R DemR AbsW
op div (1+iz)/(1-iz)I DemI AbsW
sensor result block1 @copper
format "Agora o ln..."
format "a = (1+iz)/(1-iz)R"
format "b = (1+iz)/(1-iz)I"
sensor result block1 @copper
format "Ln de (a+bi):"
format "ln(sqrt(a^2+b^2)) = (1/2) * ln(a^2+b^2)"
